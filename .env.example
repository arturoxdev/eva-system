# Eva — variables de entorno. Copia este archivo a `.env` y rellena los valores.
# NUNCA commitees `.env` con valores reales.

# Base de datos Postgres (Neon). Cadena de conexión completa.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# next-auth (Auth.js) v5
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Retell (telefonía/voz IA)
RETELL_API_KEY=

# Stripe (cobros)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secreto para endpoints de cron
CRON_SECRET=

# API key para la API externa pública
EXTERNAL_API_KEY=

# Secreto compartido del webhook de n8n (Retell → n8n → Eva)
N8N_WEBHOOK_SECRET=

# ── Chat con IA (Módulo de chat, OpenRouter vía Vercel AI SDK) ───────────────
# API key de OpenRouter (https://openrouter.ai/keys). Requerida por /api/chat.
OPENROUTER_API_KEY=
# Modelo a usar en el chat. Default barato/rápido del PRD si se omite.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
